#     podman pull "${IMAGE}"
#
#     echo "==> Restarting container in pod ${POD_NAME}..."
#     podman stop "${CONTAINER_NAME}" || true
#     podman rm "${CONTAINER_NAME}" || true
#     # Re-run container inside existing pod or restart pod
#     podman pod restart "${POD_NAME}"
# fi

# ==============================================================================
# Option C: Lightweight Kubernetes (K3s / MicroK8s)
