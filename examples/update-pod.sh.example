#!/usr/bin/env bash
# Example script to pull a new container image and restart the container in a pod on Raspberry Pi.
# Place this script in your service repository (e.g. scripts/update-pod.sh or update-pod.sh).
# Make sure it has execute permissions: chmod +x update-pod.sh

set -euo pipefail

echo "==> Starting container/pod update on $(hostname)..."

# ==============================================================================
# Option A: Docker Compose
# ==============================================================================
if command -v docker &>/dev/null && [ -f docker-compose.yml ]; then
    echo "==> Pulling updated image with Docker Compose..."
    docker compose pull
    echo "==> Recreating and restarting container..."
    docker compose up -d --remove-orphans
    echo "==> Container status:"
    docker compose ps
fi

# ==============================================================================
# Option B: Podman Pod
# ==============================================================================
